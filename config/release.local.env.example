# Copy to config/release.local.env (not in git) and fill in your own values.
# Read by the release scripts through scripts/release/local-config.sh.

# Developer ID signing identity (keychain) and the provisioning profile that
# grants the FSKit module entitlement to the file system extension.
VOLISLE_SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"
VOLISLE_PROFILE="$HOME/path/to/Your_FS_Developer_ID.provisionprofile"

# App Store Connect API key for notarization.
VOLISLE_NOTARY_KEY_ID="ABCDE12345"
VOLISLE_NOTARY_KEY="$HOME/private_keys/AuthKey_ABCDE12345.p8"
VOLISLE_NOTARY_ISSUER="00000000-0000-0000-0000-000000000000"

# Website server: an ssh host alias with key login, the live site symlink and
# the directory that keeps every uploaded release.
VOLISLE_DEPLOY_HOST="your-server"
VOLISLE_SITE_DIR="/srv/www/volisle"
VOLISLE_RELEASES_DIR="/srv/www/volisle-releases"
