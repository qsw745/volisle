--- a/ntfsprogs/mkntfs.c
+++ b/ntfsprogs/mkntfs.c
@@ -3459,8 +3459,28 @@
 		free(p);
 		p = q;
 	}
+	/* Volisle: the host may format again in the same process; leave no
+	 * dangling list, leaked buffer or stale size/count behind. */
+	g_allocation = NULL;
+	free(g_upcaseinfo);	g_upcaseinfo	= NULL;
+	g_num_bad_blocks = 0;
+	g_dynamic_buf_size = 0;
+	g_mft_bitmap_byte_size = 0;
+	g_lcn_bitmap_byte_size = 0;
+	g_mft_size = 0;
